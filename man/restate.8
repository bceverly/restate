.BR curl (1),
.BR gpgv (1),
.BR gzip (1),
.BR mtree (8),
.BR tar (1),
.BR rsync (1),
.BR sha256sum (1),
.BR dpkg (1),
.BR pkg (8),
.BR pkg_info (1)
