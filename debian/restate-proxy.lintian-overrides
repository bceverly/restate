# restate-proxy is linked from every one of restate's own objects (the
# Makefile's LIB_SRC), and with them comes restate's reader of dpkg's
# database -- the path strings lintian finds. The proxy never calls it: it
# serves repositories, and reads no package database, nor writes one.
restate-proxy: uses-dpkg-database-directly [usr/sbin/restate-proxy]
