/*
 * The command table, included the same way as options.def.
 *
 *   RS_CMD(id, name, arguments, minimum, maximum, help)
 *
 * `maximum` of -1 means "any number". The help text flows into --help, the
 * manpage and the README exactly as the option help does.
 */

RS_CMD(CMD_CAPTURE,  "capture",  "",           0,  0,
       "walk the tree and write an image (-o FILE.tar): index.json and the "
       "content of everything kept")
RS_CMD(CMD_SCAN,     "scan",     "",           0,  0,
       "walk the tree and write its index alone, as JSON, with no content")
RS_CMD(CMD_ESTIMATE, "estimate", "",           0,  0,
       "walk the tree, reading no file, and say how much a first capture would keep, by "
       "directory: what to exclude before a first capture that would not fit")
RS_CMD(CMD_DIFF,     "diff",     "OLD NEW",    2,  2,
       "compare two images or indexes: A added, D deleted, M modified, and how")
RS_CMD(CMD_VERIFY,   "verify",   "IMAGE",      1,  1,
       "compare an image or index against the tree as it is now")
RS_CMD(CMD_STATUS,   "status",   "IMAGE",      1,  1,
       "what has changed since a capture, quickly: as verify, but a file whose size, "
       "times and inode are unchanged is not read")
RS_CMD(CMD_SIGN,     "sign",     "IMAGE",      1,  1,
       "sign an image or snapshot already written, with --sign-with: so a capture run "
       "unattended needs no secret key on the machine")
RS_CMD(CMD_INIT,     "init",     "DIR",        1,  1,
       "make an empty repository at DIR: captures into it (-o DIR) are kept as snapshots, "
       "each file's content stored once, and only what changed is read")
RS_CMD(CMD_SNAPSHOTS, "snapshots", "REPO",     1,  1,
       "list the snapshots in a repository, oldest first; REPO::NAME names one wherever "
       "an image can be named, and REPO alone its newest")
RS_CMD(CMD_PRUNE,    "prune",    "REPO",       1,  1,
       "drop the snapshots --keep-last, --keep-daily, --keep-weekly and --keep-monthly do "
       "not keep, and the content nothing left refers to")
RS_CMD(CMD_CHECK,    "check",    "REPO",       1,  1,
       "check a repository: read every pack through, each chunk against the digest its index "
       "gives, and check that every snapshot's index and kit can be read and the content of "
       "each of its files is whole; with --read-all, read every snapshot in full too")
RS_CMD(CMD_COPY,     "copy",     "SNAPSHOT DEST", 2, 2,
       "copy a snapshot, and the packs it needs that DEST has not got, to the repository "
       "DEST -- made if it is not there -- exactly as they are: an encrypted repository's "
       "copy is encrypted, and nothing is decrypted")
RS_CMD(CMD_DU,       "du",       "REPO",       1,  1,
       "say how much a repository holds, and what each snapshot needs of it, adds to it and "
       "would free if it were dropped, without reading any pack or needing any key")
RS_CMD(CMD_EXPORT,   "export",   "SNAPSHOT",   1,  1,
       "write a snapshot as an image (-o FILE.tar) to take elsewhere, encrypted and "
       "signed if asked")
RS_CMD(CMD_RESTORE,  "restore",  "IMAGE",      1,  1,
       "put an image's files back under the root (--root, default /): each checked "
       "against the index before it is put in place, with its owner, mode and times")
RS_CMD(CMD_MACHINE,  "machine",  "",           0,  0,
       "describe this machine: hardware, firmware, disks, partitions, encryption, "
       "LVM, RAID, mounts")
RS_CMD(CMD_PACKAGES, "packages", "[IMAGE]",    0,  1,
       "list what is installed, and where each package came from -- apt, snap, "
       "flatpak, pip, npm, cargo -- here, or on the machine IMAGE was taken from")
RS_CMD(CMD_INSTALLER, "installer", "[fetch] [IMAGE]", 0, 2,
       "show the installer that rebuilds this machine, or the one IMAGE was taken "
       "from; with fetch, download it and check its signature")
RS_CMD(CMD_BASELINE, "baseline", "[fetch] [IMAGE]", 0, 2,
       "list the exact packages this machine, or the one IMAGE was taken from, had installed; "
       "with fetch, download each at its version, checked against its repository's signed "
       "index, into a cache that restore --packages installs from")
RS_CMD(CMD_BUILDSHEET, "buildsheet", "[IMAGE]", 0, 1,
       "write a plain-text runbook to rebuild this machine, or the one IMAGE was "
       "taken from: disks, encryption, LVM, filesystems, installer, restore")
RS_CMD(CMD_AUTOINSTALL, "autoinstall", "[IMAGE]", 0, 1,
       "write an Ubuntu autoinstall file that rebuilds this machine, or the one "
       "IMAGE was taken from, unattended: storage, locale, network, identity")
RS_CMD(CMD_CLASSIFY, "classify", "PATH...",    1, -1,
       "show the class each path falls under, and the rule that decided it")
RS_CMD(CMD_RULES,    "rules",    "",           0,  0,
       "print the rules in effect, in the format --rules reads")
RS_CMD(CMD_RUN,      "run",      "JOBFILE",    1,  1,
       "run the job JOBFILE describes -- a capture, prune, check, copy, restore and the rest, "
       "with its options -- from a file only its owner can change (see JOBS)")
RS_CMD(CMD_FEATURES, "features", "",           0,  0,
       "list what this restate can do: its commands, options, job keys, result schema and "
       "the hooks here, for a program to check before it asks for any of them")
