/*
 * The option table -- the one place an option is defined.
 *
 * Included with RS_OPT defined differently each time: once to build the
 * getopt_long table, once to build the short-option string, and once to print
 * the help. scripts/gen-man.sh then generates the manpage from that help, so
 * adding an option here updates the parser, --help, the manpage and the
 * README's Usage block together.
 *
 *   RS_OPT(code, long name, argument, argument name, help)
 *
 * `code` is the short letter, or one of the OPT_* constants above 255 (in
 * opts.h) for an option with no short form.
 */

RS_OPT('r', "root",             required_argument, "DIR",
       "treat DIR as the root of the tree to scan, verify, or list the packages of "
       "(default /)")
RS_OPT('o', "output",           required_argument, "FILE",
       "write to FILE instead of standard output; created mode 0600, replaced atomically. "
       "capture: FILE may be a repository (restate init), which the capture adds a "
       "snapshot to")
RS_OPT('R', "rules",            required_argument, "FILE",
       "read more rules from FILE, applied after the built-in ones; repeatable")
RS_OPT('N', "no-default-rules", no_argument,       NULL,
       "start from no rules at all rather than the built-in set")
RS_OPT(OPT_OS, "os",            required_argument, "NAME",
       "use the built-in rules for NAME (linux, freebsd, openbsd, netbsd, darwin) "
       "rather than this system's")
RS_OPT(OPT_RULES_ONLY, "rules-only", no_argument,   NULL,
       "classify by the rules alone, without checking files against the packages "
       "that installed them")
RS_OPT('a', "all",              no_argument,       NULL,
       "record expendable paths too: caches, logs, downloaded packages")
RS_OPT('B', "baseline-content", no_argument,       NULL,
       "capture: keep the content of baseline files too, not only their digests")
RS_OPT(OPT_ENCRYPT_TO, "encrypt-to", required_argument, "KEYFILE",
       "capture, export: encrypt the image to the OpenPGP public key in KEYFILE "
       "(gpg --export); repeatable, for more than one recipient. init: make the repository "
       "an encrypted one; capture and prune then need the keys again, each time")
RS_OPT(OPT_SIGN_WITH, "sign-with", required_argument, "KEYFILE",
       "capture, sign, export: sign the image or snapshot with the OpenPGP secret key in "
       "KEYFILE (gpg --export-secret-keys)")
RS_OPT(OPT_TRUSTED_KEY, "trusted-key", required_argument, "KEYFILE",
       "restore, verify, diff, status, export: accept an image or snapshot only if it is "
       "signed by the OpenPGP public key in KEYFILE (gpg --export); autoinstall: have the "
       "restore check that; repeatable")
RS_OPT(OPT_ALLOW_UNVERIFIED, "allow-unverified", no_argument, NULL,
       "restore: restore an image that is unsigned, or not signed by a --trusted-key, "
       "warning of it; by default it is refused")
RS_OPT(OPT_KEEP_LOCAL, "keep-local-packages", no_argument, NULL,
       "capture: keep the .deb and .snap files of installed packages no repository "
       "or store has, from apt's and snapd's caches, so a rebuild can install them")
RS_OPT(OPT_DEB, "deb",              required_argument, "NAME=FILE",
       "capture, with --keep-local-packages: keep FILE as the .deb of package NAME, "
       "which no repository has and apt's cache does not hold; repeatable")
RS_OPT(OPT_QUIESCE, "quiesce",       no_argument,       NULL,
       "capture: pause each database, VM and container found running while its own "
       "files are copied, and resume it after, with the hooks for each (see LIVE SERVICES)")
RS_OPT(OPT_SYSLOG, "syslog",        no_argument,       NULL,
       "capture, prune: say how the run ended in the system log too, as one line of "
       "key=value pairs a monitoring system can match on")
RS_OPT(OPT_FETCH_SOURCES, "fetch-sources", no_argument, NULL,
       "capture, packages: also fetch each apt source's index as its repository serves "
       "it now (with curl), and check that against the source's keys")
RS_OPT('x', "one-file-system",  no_argument,       NULL,
       "record mount points but do not descend into other filesystems")
RS_OPT('n', "no-hash",          no_argument,       NULL,
       "record metadata only; much faster, but content is then judged by size and mtime")
RS_OPT(OPT_CACHE, "cache",      required_argument, "DIR",
       "installer fetch, baseline fetch: keep what is downloaded in DIR rather than the "
       "system's cache; restore --packages: take packages from there")
RS_OPT(OPT_MIRROR, "mirror",    required_argument, "URL",
       "installer fetch: download from the directory at URL (https:// or file://) "
       "rather than the vendor's")
RS_OPT(OPT_TARGET, "target",    required_argument, "KIND",
       "buildsheet, autoinstall: rebuild as a virtual machine (vm) or on other "
       "hardware (metal) rather than the same machine")
RS_OPT(OPT_FIRMWARE, "firmware", required_argument, "MODE",
       "buildsheet, autoinstall, with --target: boot the rebuilt machine by UEFI (uefi) or "
       "BIOS (bios) rather than as the old one did, with the partition that needs")
RS_OPT(OPT_EXACT_VERSIONS, "exact-versions", no_argument, NULL,
       "buildsheet, autoinstall, restore --packages: each package at the "
       "version recorded, from the archive's snapshot (snapshot.ubuntu.com, "
       "snapshot.debian.org) where the archive has moved on, rather than the newer one")
RS_OPT(OPT_IMAGE_AT, "image-at", required_argument, "PATH",
       "autoinstall: where the installer will find the image (a mounted disk or "
       "share); the file then installs the packages and restores the files from it")
RS_OPT(OPT_EXCLUDE, "exclude",        required_argument, "PATTERN",
       "restore: leave out PATTERN (written as in a rules file, everything beneath "
       "it too); repeatable")
RS_OPT(OPT_NUMERIC_OWNER, "numeric-owner", no_argument,     NULL,
       "restore: owners by the numbers the index records, and the image's own account "
       "files, rather than by name through the image's accounts merged with the system's")
RS_OPT(OPT_IMAGE_FSTAB, "image-fstab", no_argument,     NULL,
       "restore: put back the image's /etc/fstab and /etc/crypttab even where they name "
       "disks this machine does not have; by default the machine's own are kept then, "
       "so that it still boots")
RS_OPT(OPT_OFFLINE, "offline",        no_argument,       NULL,
       "restore --packages: with no network at all -- every apt package from the baseline "
       "cache (restate baseline fetch) and the image's kept .deb files, which apt is given "
       "as its only repository; snaps, flatpaks and the Python, npm and Ruby packages are "
       "left out, but for the snaps the image keeps")
RS_OPT(OPT_PACKAGES, "packages",       no_argument,       NULL,
       "diff: say which packages were installed, removed and upgraded, and leave out the "
       "file changes they account for. restore: put the image's packages back first -- its "
       "repositories and keys, its packages at their versions (from the baseline cache where "
       "fetched), what was installed by hand and what as a dependency -- and remove what it "
       "did not have; root only, onto the running system")
RS_OPT(OPT_CHECK_FIRST, "check-first", no_argument,     NULL,
       "restore: read the whole image first, checking every file against the index and "
       "writing nothing, and put it back only if all of it is whole")
RS_OPT(OPT_DRY_RUN, "dry-run",        no_argument,       NULL,
       "restore: check the image and say what would be put back, writing nothing; "
       "prune: say which snapshots would be dropped, dropping none")
RS_OPT(OPT_KEEP_LAST, "keep-last",    required_argument, "N",
       "prune: keep the newest N snapshots")
RS_OPT(OPT_KEEP_DAILY, "keep-daily",  required_argument, "N",
       "prune: keep the newest snapshot of each of the last N days that have one")
RS_OPT(OPT_KEEP_WEEKLY, "keep-weekly", required_argument, "N",
       "prune: keep the newest snapshot of each of the last N weeks that have one")
RS_OPT(OPT_KEEP_MONTHLY, "keep-monthly", required_argument, "N",
       "prune: keep the newest snapshot of each of the last N months that have one")
RS_OPT('P', "progress",         no_argument,       NULL,
       "show progress on standard error: paths and bytes so far while walking, "
       "a percentage and time left while writing an image or downloading")
RS_OPT('q', "quiet",            no_argument,       NULL,
       "no warnings and no summary; errors are still reported")
RS_OPT('v', "verbose",          no_argument,       NULL,
       "report every path the rules skip, and why")
RS_OPT('h', "help",             no_argument,       NULL,
       "print this help and exit")
RS_OPT('V', "version",          no_argument,       NULL,
       "print the version and exit")
